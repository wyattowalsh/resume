{
  "name": "resume-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9 <11"
  },
  "scripts": {
    "dev": "vike dev",
    "build": "vike build",
    "docs:dev": "pnpm -C docs dev",
    "docs:build": "pnpm -C docs build",
    "check:docs": "pnpm -C docs build",
    "serve": "cross-env NODE_ENV=production node server",
    "build:script": "tsc --project tsconfig.node.json",
    "lint": "eslint api renderer src vite.config.ts postcss.config.ts tailwind.config.ts --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "pnpm build && pnpm serve",
    "test": "vitest run",
    "sync:skill-icons": "pnpm build:script && node src/scripts/sync-skill-icons.js",
    "generate:resume": "pnpm build:script && node src/scripts/generate.js",
    "check:artifacts": "pnpm generate:resume && pnpm sync:public-downloads && node src/scripts/check-artifacts.js",
    "check:artifacts:current": "pnpm build:script && RESUME_ARTIFACT_RECENCY=skip node src/scripts/check-artifacts.js",
    "sync:public-downloads": "mkdir -p public/downloads && cp assets/outputs/resume-full.pdf public/downloads/wyatt-walsh-resume-full.pdf && cp assets/outputs/resume-single.pdf public/downloads/wyatt-walsh-resume-single.pdf && cp assets/outputs/resume-full.docx public/downloads/wyatt-walsh-resume-full.docx && cp assets/outputs/resume-single.docx public/downloads/wyatt-walsh-resume-single.docx"
  },
  "dependencies": {
    "@fontsource/monaspace-argon": "^5.2.5",
    "@fontsource/monaspace-krypton": "^5.2.5",
    "@fontsource/monaspace-neon": "^5.2.5",
    "@fontsource/monaspace-xenon": "^5.2.5",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "docx": "9.6.1",
    "express": "^5.2.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "vike": "^0.4.259",
    "vike-react": "^0.6.21",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vercel/node": "^5.7.15",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "husky": "^9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "^17.0.2",
    "pdfjs-dist": "5.7.284",
    "playwright": "^1.59.1",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "puppeteer": "^24.43.0",
    "tailwindcss": "^4.2.4",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "@vercel/static-config@*>ajv": "^8.18.0",
      "minimatch": "^10.2.3",
      "rollup": "^4.59.0",
      "smol-toml": "^1.6.1",
      "@vercel/node@*>undici": "^6.24.0"
    }
  }
}
