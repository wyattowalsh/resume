    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "puppeteer": "^24.10.1",
    "tailwindcss": "^4.1.10",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.3.4",
